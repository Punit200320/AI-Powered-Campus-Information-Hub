# OpenRouter API key for the Gen AI / RAG endpoints
OPENROUTER_API_KEY=

# JWT secret MUST match `app.jwt.secret` in the Spring Boot
# application.properties. The FastAPI service uses it to verify the
# Bearer tokens issued by the Spring Boot (OAuth2 / password) login,
# so only authenticated campus users can call these AI endpoints.
#
# IMPORTANT: this is an EXAMPLE. Generate a real random long secret and
# keep it out of version control. If this service is run without
# JWT_SECRET set, it fails fast (RuntimeError) rather than using a
# default. Use e.g. `python -c "import secrets; print(secrets.token_hex(48))"`.
JWT_SECRET=replace-me-with-a-long-random-secret
