# ============================================================
# OAuth2 (Google) credentials for the Campus AI Spring Boot backend
# Create credentials at https://console.cloud.google.com/apis/credentials
#   Authorized redirect URIs must include:
#     http://localhost:5000/login/oauth2/code/google
# ============================================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/login/oauth2/code/google

# Frontend origin the OAuth success handler redirects to after sign-in
FRONTEND_URL=http://localhost:5173

# ============================================================
# JWT signing secret shared by the Spring Boot service (CAMPUS_JWT_SECRET)
# and the FastAPI GenAI/RAG service (JWT_SECRET). These two values MUST be
# identical, long and random. No committed default - if missing, the
# services fail fast at startup.
# Generate: python -c "import secrets; print(secrets.token_hex(48))"
# ============================================================
CAMPUS_JWT_SECRET=replace-me-with-a-long-random-secret
JWT_SECRET=replace-me-with-a-long-random-secret
